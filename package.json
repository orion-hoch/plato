{
  "name": "plato",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --no-warnings --env-file-if-exists=.env server/index.mjs --production",
    "dev": "node --no-warnings --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs backend/test/*.test.mjs backend/test/acceptance/*.test.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.26.0",
    "@napi-rs/canvas": "1.0.10",
    "d3-hierarchy": "3.1.2",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "mathjs": "^15.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.12"
  },
  "private": true
}
