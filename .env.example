# Every model runs through your ChatGPT sign-in: install the Codex CLI and run `codex login`.
# Four settings, each a model and an effort (README, "Models"). Some jobs set their own effort in code
# (exam problems, modules and new files at high; drawing reads low).

# The light model: answer classification and checks, page transcription.
LUNA_LIGHT=gpt-6-luna
LUNA_LIGHT_EFFORT=low
# The deep model for work prepared ahead: the course build, validators, the learner model, questions, the course model.
LUNA_DEEP=gpt-6-astra
LUNA_DEEP_EFFORT=high
# The director: the card for an answer no prepared branch covers, and think (default: the deep model).
# LUNA_DIRECTOR=gpt-6-astra
LUNA_DIRECTOR_EFFORT=low
# The voice agent ElevenLabs hosts (scripts/setup-tutor-agent.mjs). gpt-6.1-sol has no "none" effort; low is its fastest.
LUNA_VOICE=gpt-6.1-sol
LUNA_VOICE_EFFORT=low
# Older names still work as fallbacks: LUNA_HEAVY, LUNA_HEAVY_EFFORT (deep); LUNA_PLANNER, LUNA_PLANNER_EFFORT
# (director); LUNA_AGENT_LLM, LUNA_AGENT_EFFORT (voice).

# One provider: the whole harness on your Claude sign-in (`claude` CLI), no Codex (docs/harness-generalization.md).
# LUNA_MODELS=claude            # every backend model call through the Claude CLI (server/claude-runtime.mjs)
# LUNA_CLAUDE_DEEP=sonnet       # its model for the deep, director and reply lanes
# LUNA_CLAUDE_LIGHT=haiku       # its model for the light lanes
# LUNA_CLAUDE_LIMIT=6           # Claude processes per lane at once
# LUNA_KNOWLEDGE=guide          # new courses publish their topics from their files and study guide: no knowledge build
# LUNA_ACTOR_BRAIN=claude       # Plato himself on Claude (Opus)
# LUNA_CLAUDE_MODEL=opus        # the course builder's agents (planner, unit writers, auditors)
# LUNA_SMOKE=2                  # test lessons per new course, on its riskiest topics (0: none)
# LUNA_REVIEW=0                 # turn off the colleague's checks of Plato's boards and verdicts
# LUNA_CHECK_MODEL=sonnet       # the colleague's model

# Voice: the ElevenLabs agent that plays the actor. scripts/setup-tutor-agent.mjs creates it and writes its ID here.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Server
PORT=5188
# LUNA_DATA_DIR=./data          # where the database and uploads live (evals run on a copy)
# LUNA_WORKERS=16               # job workers: 2 for live turns, up to 12 for long builds
# LUNA_PAGE_CONCURRENCY=4       # PDF pages transcribed in parallel
# LUNA_REPLY_TIER=priority      # Codex tier for the reply path: priority (Fast, more usage) or default
# CODEX_BIN=/absolute/path/to/codex   # if codex is not on PATH

# Development only
# LUNA_LOCAL_ACTOR=1            # play Plato on a local model: open the page with ?local-actor (no ElevenLabs)
# BACKEND_DEBUG=1               # log errors the backend otherwise swallows
# LUNA_DEBUG_RUNTIME=1          # log Codex process exits
# LUNA_CLOCK_OFFSET_MS=86400000 # shift the backend clock (e.g. "the next day" in a sandbox)
# LUNA_COURSE_MODEL=off         # hide the course model (ablation)
