# Plato runs on your own Claude or ChatGPT subscription, through its command-line tool. `npm run setup` sets this.
PLATO_PROVIDER=claude            # claude (Claude Code: `claude`) or codex (ChatGPT: `codex login`)

PORT=5188
# LUNA_DATA_DIR=./data           # your courses, chats and checkpoints

# Models. Claude: Plato and the course builder on Opus; the background lanes on these.
# LUNA_CLAUDE_MODEL=opus         # Plato and the course builder's agents
# LUNA_CLAUDE_DEEP=sonnet        # course work prepared ahead, checks
# LUNA_CLAUDE_LIGHT=haiku        # small jobs (page transcription, answer checks)
# LUNA_CLAUDE_EFFORT=            # low|medium|high: how long Plato thinks before his first word
# ChatGPT: the deep model is Plato and the builder; the light one the small jobs.
# LUNA_DEEP=gpt-6-astra
# LUNA_LIGHT=gpt-6-luna
# LUNA_ACTOR_EFFORT=medium

# Course building
# LUNA_SMOKE=2                   # test lessons per new course, on its riskiest topics (0: none)
# LUNA_REVIEW=0                  # turn off a second model's checks of Plato's boards and verdicts
# LUNA_CHECK_MODEL=sonnet        # that checker's model (Claude)

# Optional: the ElevenLabs voice agent instead of the text chat (build with VITE_VOICE=eleven).
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# VITE_VOICE=eleven

# Development
# LUNA_LOCAL_ACTOR=1             # macOS: Plato's spoken voice and hearing in the dev server (?local-actor=speak)
# BACKEND_DEBUG=1                # log errors the backend otherwise swallows
