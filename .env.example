# Plato runs on your own Claude or ChatGPT subscription, through its command-line tool. `npm run setup` sets this.
PLATO_PROVIDER=claude            # claude (Claude Code: `claude`) or codex (ChatGPT: `codex login`)

PORT=5188
# PLATO_DATA_DIR=./data           # your courses, chats and checkpoints

# Models. Claude: Plato and the course builder on Opus; the background lanes on these.
# PLATO_CLAUDE_MODEL=opus         # Plato and the course builder's agents
# PLATO_CLAUDE_DEEP=sonnet        # course work prepared ahead, checks
# PLATO_CLAUDE_LIGHT=haiku        # small jobs (page transcription, answer checks)
# PLATO_CLAUDE_EFFORT=            # low|medium|high: how long Plato thinks before his first word
# ChatGPT: the deep model is Plato and the builder; the light one the small jobs.
# PLATO_DEEP=gpt-6-astra
# PLATO_LIGHT=gpt-6-luna
# PLATO_ACTOR_EFFORT=medium

# Course building
# PLATO_SMOKE=2                   # test lessons per new course, on its riskiest topics (0: none)
# PLATO_REVIEW=0                  # turn off a second model's checks of Plato's boards and verdicts
# PLATO_CHECK_MODEL=sonnet        # that checker's model (Claude)

# Voice (reading replies aloud, talking to Plato): paste your ElevenLabs API key in Plato itself (the speaker or microphone
# button). It is kept in your macOS Keychain, not here.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # which ElevenLabs voice reads his replies
# PLATO_TTS_MODEL=eleven_v4_turbo
# PLATO_STT_MODEL=scribe_v1

# Development
# BACKEND_DEBUG=1                # log errors the backend otherwise swallows
